# EXAMPLE (optional): a light chat page to test the AI gateway end to end, at https://<node>/chat/
# Generated into chat-ui.yaml by scripts/build.py. Apply on the node:
#   sudo k3s kubectl apply -f https://raw.githubusercontent.com/equinix-svc/svc-helm-daihub/main/examples/chat-ui/chat-ui.yaml
# Remove: sudo k3s kubectl delete -f <same url>
# The page is static: the browser calls LiteLLM on the same host (/v1/chat/completions) with the key you paste in it.
apiVersion: v1
kind: ConfigMap
metadata: { name: chat-ui, namespace: ai-gateway }
data:
  index.html: |
    @@FILE examples/chat-ui/index.html@@
  default.conf: |
    @@FILE examples/chat-ui/default.conf@@
---
apiVersion: apps/v1
kind: Deployment
metadata: { name: chat-ui, namespace: ai-gateway }
spec:
  replicas: 1
  selector: { matchLabels: { app: chat-ui } }
  template:
    metadata: { labels: { app: chat-ui } }
    spec:
      containers:
        - name: nginx
          image: nginx:1.27-alpine
          ports: [{ containerPort: 80 }]
          readinessProbe: { httpGet: { path: /chat/, port: 80 }, periodSeconds: 5 }
          volumeMounts:
            - { name: web, mountPath: /usr/share/nginx/html/chat/index.html, subPath: index.html, readOnly: true }
            - { name: web, mountPath: /etc/nginx/conf.d/default.conf, subPath: default.conf, readOnly: true }
          resources: { requests: { cpu: 5m, memory: 8Mi }, limits: { memory: 64Mi } }
      volumes:
        - { name: web, configMap: { name: chat-ui } }
---
apiVersion: v1
kind: Service
metadata: { name: chat-ui, namespace: ai-gateway }
spec: { selector: { app: chat-ui }, ports: [{ port: 80 }] }
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: chat-ui
  namespace: ai-gateway
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: web,websecure
spec:
  rules:
    - http:
        paths:
          - path: /chat
            pathType: Prefix
            backend: { service: { name: chat-ui, port: { number: 80 } } }
